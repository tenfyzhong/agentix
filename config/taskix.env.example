## Copy to ~/.config/taskix/taskix.env (or beside your custom config.toml).
## Loaded automatically by the CLI and its plugin. No shell export is required.
## Node dotenv syntax: quote literal #; double-quoted \n becomes a newline.
## No variable expansion or shell commands; duplicate keys use the last value.
## Uncomment only the settings you need. Protect files containing secrets.
## Known path settings accept ~ and ~/...; credentials and URLs stay literal.
## macOS/Linux service login shell; default: the account login shell.
# TASKIX_LOGIN_SHELL="/opt/homebrew/bin/fish"
## Host skill language; default en. Does not translate existing notes.
# TASKIX_LANG="zh-CN"
## Opt into memory for the CLI, host plugin and resident service; default false.
# TASKIX_MEMORY_ENABLED=true
## Optional plaintext credential referenced by api_key_env in config.toml.
## Other providers may name their own variable with api_key_env.
## With api_key_pass configured in TOML, no Memory credential is needed here.
## Configure and verify GPG/pinentry before using api_key_pass.
## Without pass or working pinentry, use api_key_env and the actual key below.
## See docs/pass-secrets.md for setup.
# OPENAI_API_KEY="replace-with-your-openai-key"
## Antigravity hook identity root; default: <home>/.local/share/taskix/antigravity.
# TASKIX_ANTIGRAVITY_DATA_DIR="/absolute/path/to/taskix/antigravity"

## Optional routing/lifecycle/discussion decisions; disabled by default.
## The following example selects Typesafe. Supply a real endpoint/key to enable.
# TASKIX_DECISION_ENABLED=true
## Provider identity: typesafe (default), openai, or a custom provider name.
# TASKIX_DECISION_PROVIDER="typesafe"
## Protocol: typesafe or openai_decisions; inferred for built-in providers only.
# TASKIX_DECISION_PROTOCOL="typesafe"
## Full endpoint. OpenAI's built-in default is https://api.openai.com/v1/decisions.
# TASKIX_DECISION_URL="https://api.typesafe.ai/v1/systemone"
## Only the built-in OpenAI provider/protocol can fall back to OPENAI_API_KEY.
# TASKIX_DECISION_API_KEY="replace-with-your-decision-key"
## Optional plugin pass entry; independent of Memory's api_key_pass in TOML.
## Configure GPG/pinentry BEFORE use. On macOS add
## pinentry-program /opt/homebrew/bin/pinentry-mac to ~/.gnupg/gpg-agent.conf.
## A nonempty direct key wins; a selected pass failure never falls back.
## Without working pinentry, use TASKIX_DECISION_API_KEY instead.
# TASKIX_DECISION_API_KEY_PASS="taskix/decision"
## Default model: jev-latest for Typesafe; gpt-6-luna for OpenAI Decisions.
# TASKIX_DECISION_MODEL="jev-latest"
## Routing/lifecycle/discussion threshold; default 0.65, range 0.5..1.
# TASKIX_DECISION_MIN_CONFIDENCE=0.65
## Independent memory screening threshold; default 0.75, range 0.5..1.
# TASKIX_MEMORY_DECISION_MIN_CONFIDENCE=0.75

## Persist decision observations; default false. Separate from [metrics].
# TASKIX_DECISION_METRICS_ENABLED=true
## Default: <XDG_STATE_HOME or home/.local/state>/taskix/decision-metrics.sqlite.
## Writers and `taskix routing metrics` must use the same database path.
# TASKIX_DECISION_METRICS_DB="~/.local/state/taskix/decision-metrics.sqlite"

## Logging uses [logging].level in config.toml.
## Shared networking (optional).
## HTTP client proxy variables; uppercase HTTP_PROXY/HTTPS_PROXY and lowercase
## no_proxy are also accepted. Prefer one spelling of each variable.
# http_proxy="http://127.0.0.1:7890"
# https_proxy="http://127.0.0.1:7890"
# NO_PROXY="localhost,127.0.0.1,::1"

## Compatibility only: prefer TASKIX_DECISION_* above for new configurations.
## Typesafe still accepts TASKIX_JEV_ENABLED, TASKIX_JEV_URL, TASKIX_JEV_API_KEY,
## TASKIX_JEV_MODEL, TASKIX_JEV_MIN_CONFIDENCE and
## TASKIX_MEMORY_JEV_MIN_CONFIDENCE as fallbacks for the corresponding new keys.
## TASKIX_JEV_METRICS_ENABLED / TASKIX_JEV_METRICS_DB are provider-independent
## fallbacks for TASKIX_DECISION_METRICS_ENABLED / TASKIX_DECISION_METRICS_DB.
## Do not set new and legacy names together.
## Host-owned HOME, PATH, SHELL, XDG_STATE_HOME, CLAUDE_PLUGIN_ROOT and PLUGIN_ROOT are inherited.
## TASKIX_MEMORY_LOGIN_ENVIRONMENT_PID is an internal bootstrap marker; do not set it.
