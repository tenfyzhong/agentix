## Copy to ~/.config/agentix/agentix.env (or beside your custom config.toml).
## Loaded automatically by the CLI and its plugin. No shell export is required.
## Node dotenv syntax: quote literal #; double-quoted \n becomes a newline.
## No variable expansion or shell commands; duplicate keys use the last value.
## Uncomment only the settings you need. Protect files containing secrets.
## Known path settings accept ~ and ~/...; credentials and URLs stay literal.
## macOS/Linux login shell for the service and spawned agent processes.
## Default: the account login shell. Must be an absolute executable path.
# AGENTIX_LOGIN_SHELL="/opt/homebrew/bin/fish"

## Bridge endpoint; keep it consistent with [server].endpoint.
## Default: unix://<home>/.local/share/agentix/control.sock.
# AGENTIX_CONTROL_ENDPOINT="unix:///absolute/path/to/agentix/control.sock"
## Claude delivery: auto (default), multiplexer, or channel.
# AGENTIX_CLAUDE_DELIVERY="auto"
## Bridge mailbox/state roots; defaults are <home>/.local/share/agentix/<backend>.
## Keep these consistent with the corresponding agent backend configuration.
# AGENTIX_CLAUDE_DATA_DIR="/absolute/path/to/agentix/claude"
# AGENTIX_OPENCODE_STATE_DIR="/absolute/path/to/agentix/opencode"
# AGENTIX_ANTIGRAVITY_DATA_DIR="/absolute/path/to/agentix/antigravity"
## Native Antigravity session root for a new session before its first input.
## Default: <home>/.gemini/antigravity-cli/brain.
# AGENTIX_ANTIGRAVITY_SESSION_DIR="/absolute/path/to/antigravity-cli/brain"
## Codex home used for endpoint/token resolution; default: <home>/.codex.
# CODEX_HOME="~/.codex"

## Shared networking and diagnostics (optional).
## RUST_LOG overrides [logging].level for the resident service.
# RUST_LOG="info"
## HTTP client proxy variables; uppercase HTTP_PROXY/HTTPS_PROXY and lowercase
## no_proxy are also accepted. Prefer one spelling of each variable.
# http_proxy="http://127.0.0.1:7890"
# https_proxy="http://127.0.0.1:7890"
# NO_PROXY="localhost,127.0.0.1,::1"

## Host-owned context: inherit HOME, PATH, SHELL and (on Windows) PATHEXT.
## Do not persist per-pane TMUX, TMUX_PANE, REX_SESSION, REX_BLOCK or REX_SERVER.
## AGENTIX_SERVICE_ENVIRONMENT_PID is an internal bootstrap marker; do not set it.
## Channel credentials belong in [channel.<kind>], not environment variables.
## Taskix host settings (TASKIX_LANG, TASKIX_*, provider keys) are documented
## in taskix.env.example; each plugin loads its own file automatically.
