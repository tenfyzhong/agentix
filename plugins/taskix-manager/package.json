{
  "name": "taskix-manager",
  "version": "0.2.1",
  "description": "Shared taskix workflow for Codex, Claude, Pi, and OMP",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    ".codex-plugin/",
    ".claude-plugin/",
    "extensions/",
    "hooks/",
    "skills/",
    "obsidian/",
    "vendor/",
    "runtime.mjs",
    "taskix-cli.mjs",
    "routing-context.mjs",
    "conversation.mjs",
    "discussion.mjs",
    "lifecycle.mjs",
    "README.md",
    "jev.mjs",
    "jev-io.mjs",
    "routing-state.mjs",
    "jev-metrics.mjs",
    "jev-metrics-worker.mjs",
    "metrics-schema.sql",
    "metrics-schema.md",
    "memory.mjs"
  ],
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "check:vendor": "node scripts/build-vendor.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/omp.ts"
    ]
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "esbuild": "0.28.2"
  }
}
