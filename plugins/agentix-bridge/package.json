{
  "name": "agentix-bridge",
  "version": "0.2.0",
  "description": "Connect live Pi, OMP, Claude Code, and OpenCode terminals to Agentix",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "runtime.mjs",
    "new-session.mjs",
    "extensions/",
    "README.md",
    "protocol/",
    "queue.mjs",
    "transport.mjs",
    "usage.mjs",
    "framing.mjs",
    "host.mjs",
    "session.mjs",
    "claude/",
    ".claude-plugin/",
    ".mcp.json",
    "hooks/",
    "opencode/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/omp.ts"
    ]
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.28.2"
  },
  "exports": {
    "./tui": "./opencode/tui.mjs"
  }
}
